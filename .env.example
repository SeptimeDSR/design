# --- MCP -------------------------------------------------------------------
# 21st MCP (ex-Magic MCP). Free key at https://21st.dev/mcp — export it in your shell
# before launching Claude Code: export TWENTY_FIRST_API_KEY=...
TWENTY_FIRST_API_KEY=

# --- PRO assets (optional). Leave empty => the FREE version renders instead. ---
# Spline scene exported via "Code export > React" (https://prod.spline.design/.../scene.splinecode)
NEXT_PUBLIC_SPLINE_SCENE=
# Hero video generated with Higgsfield / Runway / Pika (credits), e.g. /videos/hero.mp4
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- SEPTIM-VIRAL-OS (tout est optionnel : sans rien, l'usine tourne en FREE) ---
VIRAL_LANG=fr                       # fr | en
VIRAL_REGIONS=CM,FR,CI,SN           # Google Trends (pas de flux CM) + YouTube Trending
VIRAL_CRON=0 */6 * * *              # toutes les 6 h
VIRAL_NOTIFIER=whatsapp             # whatsapp | console
VIRAL_WHATSAPP_TO=                  # vide = tu t'écris à toi-même ; sinon numéro au format 2376XXXXXXXX
WHATSAPP_CHROME_PATH=               # Google Chrome (pas Chromium) pour envoyer de vraies vidéos ; vide = envoi en document
VIRAL_TTS=auto                      # auto | piper | kokoro | silent
VIRAL_PIPER_VOICE=fr_FR-tom-medium  # voix grave FR (python3 -m piper.download_voices fr_FR-tom-medium)
VIRAL_PIPER_DIR=.septim-viral/voices
VIRAL_OLLAMA_MODEL=qwen2.5:7b       # qwen2.5:3b si la machine a peu de RAM
OLLAMA_HOST=http://127.0.0.1:11434
YOUTUBE_API_KEY=                    # gratuit (Google Cloud) : tendances YouTube du Cameroun
APIFY_TOKEN=                        # optionnel (offre gratuite 5 $/mois) : tendances TikTok Creative Center
VIRAL_APIFY_ACTOR=eunit/tiktok-trends-scraper
VIRAL_APIFY_INPUT=
# Publication : manual (FREE) par défaut. Postiz : POSTIZ_API_KEY (cloud, 29 $/mois, apps approuvées)
# ou POSTIZ_API_URL=https://ton-postiz (auto-hébergé, gratuit, TikTok/YouTube privés tant que tes apps ne sont pas auditées).
POSTIZ_API_KEY=
POSTIZ_API_URL=
VIRAL_PUBLISH_MODE=                 # forcer : manual | postiz-cloud | postiz-self
VIRAL_TIKTOK_METHOD=DIRECT_POST     # UPLOAD = brouillon dans l'app pour ajouter le son tendance
VIRAL_PLATFORMS=tiktok,youtube,instagram,facebook
REMOTION_BROWSER_EXECUTABLE=        # vide = Remotion télécharge son Chrome headless au premier rendu
