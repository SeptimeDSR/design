# --- MCP -------------------------------------------------------------------
# 21st MCP (ex-Magic MCP). Free key at https://21st.dev/mcp — export it in your shell
# before launching Claude Code: export TWENTY_FIRST_API_KEY=...
TWENTY_FIRST_API_KEY=

# --- Site ---------------------------------------------------------------------
# Ton numéro WhatsApp (format international, chiffres seuls). Vide => le bouton ouvre le choix du contact.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- PRO assets (optional). Leave empty => the FREE version renders instead. ---
# Spline scene exported via "Code export > React" (https://prod.spline.design/.../scene.splinecode)
NEXT_PUBLIC_SPLINE_SCENE=
# Hero video generated with Higgsfield / Runway / Pika (credits), e.g. /videos/hero.mp4
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- SEPTIM-VIRAL-OS (tout est optionnel : sans rien, l'usine tourne en FREE) ---
VIRAL_LANG=fr                       # fr | en
VIRAL_REGIONS=CM,FR,CI,SN           # Google Trends (pas de flux CM) + YouTube Trending
VIRAL_CRON=0 */6 * * *              # toutes les 6 h
VIRAL_NOTIFIER=whatsapp             # whatsapp | console
VIRAL_WHATSAPP_TO=                  # vide = tu t'écris à toi-même ; sinon numéro au format 2376XXXXXXXX
WHATSAPP_CHROME_PATH=               # Google Chrome (pas Chromium) pour envoyer de vraies vidéos ; vide = envoi en document
VIRAL_TTS=auto                      # auto | piper | kokoro | silent
VIRAL_PIPER_VOICE=fr_FR-tom-medium  # voix grave FR (python3 -m piper.download_voices fr_FR-tom-medium)
VIRAL_PIPER_DIR=.septim-viral/voices
VIRAL_OLLAMA_MODEL=qwen2.5:7b       # qwen2.5:3b si la machine a peu de RAM
OLLAMA_HOST=http://127.0.0.1:11434
YOUTUBE_API_KEY=                    # gratuit (Google Cloud) : tendances YouTube du Cameroun
APIFY_TOKEN=                        # optionnel (offre gratuite 5 $/mois) : tendances TikTok Creative Center
VIRAL_APIFY_ACTOR=eunit/tiktok-trends-scraper
VIRAL_APIFY_INPUT=
# Publication : manual (FREE) par défaut. Postiz : POSTIZ_API_KEY (cloud, 29 $/mois, apps approuvées)
# ou POSTIZ_API_URL=https://ton-postiz (auto-hébergé, gratuit, TikTok/YouTube privés tant que tes apps ne sont pas auditées).
POSTIZ_API_KEY=
POSTIZ_API_URL=
VIRAL_PUBLISH_MODE=                 # forcer : manual | postiz-cloud | postiz-self
VIRAL_TIKTOK_METHOD=DIRECT_POST     # UPLOAD = brouillon dans l'app pour ajouter le son tendance
VIRAL_PLATFORMS=tiktok,youtube,instagram,facebook
REMOTION_BROWSER_EXECUTABLE=        # vide = Remotion télécharge son Chrome headless au premier rendu
PUPPETEER_SKIP_DOWNLOAD=1           # whatsapp-web.js : pas de téléchargement de Chromium (extract-zip, faille sans correctif) ; utilise WHATSAPP_CHROME_PATH
# Variables avancées : laisse-les commentées tant que la valeur par défaut te va (vide ≠ absent).
# VIRAL_HOME=.septim-viral                # dossier des vidéos, tâches et leçons (relatif au repo)
# VIRAL_PYTHON=                           # python qui a Piper ; défaut : .septim-viral/venv (septim setup --voix), sinon python3
# VIRAL_PIPER_VOICE_EN=en_US-ryan-high    # voix Piper anglaise
# VIRAL_KOKORO_VOICE=am_michael           # voix Kokoro (anglais seulement)
# VIRAL_OLLAMA_TIMEOUT_MS=120000          # délai d'Ollama pour écrire un script
# VIRAL_APIFY_TIMEOUT_MS=180000           # délai d'un acteur Apify
# VIRAL_RENDER_CONCURRENCY=2              # onglets Chrome pour le rendu Remotion (plus = plus rapide, plus de RAM)
# POSTIZ_BIN=postiz                       # chemin du CLI Postiz s'il n'est pas dans le PATH

# --- Portes : Studio, API, MCP HTTP, webhooks (docs/GUIDE.md) ----------------------------
SEPTIM_PORT=4321                    # 0 = septim start sans serveur
SEPTIM_HOST=127.0.0.1               # 0.0.0.0 = ouvert au Wi-Fi (téléphone) : SEPTIM_TOKEN obligatoire
SEPTIM_TOKEN=                       # jeton d'accès (openssl rand -hex 16) ; exigé hors de 127.0.0.1
SEPTIM_CORS_ORIGINS=                # origines web permises, séparées par des virgules (ex. https://n8n.mondomaine.com)
SEPTIM_PUBLIC_URL=                  # adresse publique de l'usine (tunnel) : remplit videoUrl dans les webhooks
# SEPTIM_ROOT=                      # dossier du repo ; bin/septim.mjs le trouve tout seul
VIRAL_WEBHOOK_URL=                  # POST signé à chaque événement (video.ready, video.failed, video.published, video.rejected)
VIRAL_WEBHOOK_SECRET=               # secret HMAC-SHA256 : en-tête X-Septim-Signature: sha256=<hex>

# --- Gratuit d'abord : plans vidéo, musique, voix HD (docs/GUIDE.md, « Gratuit d'abord ») ----
VIRAL_BROLL=auto                    # auto | comfyui | stock | pexels | pixabay | none
PEXELS_API_KEY=                     # clé gratuite (https://www.pexels.com/api/) : vrais plans en rapport avec le sujet
PIXABAY_API_KEY=                    # clé gratuite (https://pixabay.com/api/docs/) : relais si Pexels ne trouve rien
COMFYUI_URL=                        # IA vidéo locale gratuite, ex. http://127.0.0.1:8188 (ComfyUI + Wan 2.2 5B, GPU NVIDIA 8 Go+)
# COMFYUI_WORKFLOW=                 # ton workflow ComfyUI au format API (LTX-2, HunyuanVideo…) avec {{prompt}}, {{seed}}, {{frames}}
# COMFYUI_WAN_MODEL=wan2.2_ti2v_5B_fp16.safetensors
# VIRAL_COMFYUI_TIMEOUT_MS=1200000  # délai par plan IA (20 min)
# VIRAL_BROLL_CLIPS=12              # plans par vidéo (4 par défaut avec ComfyUI)
VIRAL_MUSIC_DIR=                    # dossier de tes pistes (libres de droits, ou générées avec ACE-Step) ; vide = nappe lo-fi générée
# VIRAL_CHATTERBOX_VOICE=           # WAV de 10 s de TA voix pour la cloner (VIRAL_TTS=chatterbox, septim setup --voix-hd)
# VIRAL_CHATTERBOX_SCRIPT=          # avancé : autre script worker Chatterbox
